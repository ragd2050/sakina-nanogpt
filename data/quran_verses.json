{
  "13:28": {"surah_name": "الرعد", "surah_number": 13, "ayah_number": 28, "text": "الَّذِينَ آمَنُوا وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ اللَّهِ ۗ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ", "is_excerpt": false},
  "16:89": {"surah_name": "النحل", "surah_number": 16, "ayah_number": 89, "text": "وَنَزَّلْنَا عَلَيْكَ الْكِتَابَ تِبْيَانًا لِّكُلِّ شَيْءٍ", "is_excerpt": true},
  "93:3": {"surah_name": "الضحى", "surah_number": 93, "ayah_number": 3, "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ", "is_excerpt": false},
  "9:40": {"surah_name": "التوبة", "surah_number": 9, "ayah_number": 40, "text": "لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا", "is_excerpt": true},
  "12:86": {"surah_name": "يوسف", "surah_number": 12, "ayah_number": 86, "text": "قَالَ إِنَّمَا أَشْكُو بَثِّي وَحُزْنِي إِلَى اللَّهِ وَأَعْلَمُ مِنَ اللَّهِ مَا لَا تَعْلَمُونَ", "is_excerpt": false},
  "94:5": {"surah_name": "الشرح", "surah_number": 94, "ayah_number": 5, "text": "فَإِنَّ مَعَ الْعُسْرِ يُسْرًا", "is_excerpt": false},
  "39:53": {"surah_name": "الزمر", "surah_number": 39, "ayah_number": 53, "text": "قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَىٰ أَنفُسِهِمْ لَا تَقْنَطُوا مِن رَّحْمَةِ اللَّهِ ۚ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا ۚ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ", "is_excerpt": false},
  "14:7": {"surah_name": "إبراهيم", "surah_number": 14, "ayah_number": 7, "text": "لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ", "is_excerpt": true},
  "93:11": {"surah_name": "الضحى", "surah_number": 93, "ayah_number": 11, "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ", "is_excerpt": false},
  "65:2": {"surah_name": "الطلاق", "surah_number": 65, "ayah_number": 2, "text": "وَمَن يَتَّقِ اللَّهَ يَجْعَل لَّهُ مَخْرَجًا", "is_excerpt": true},
  "94:8": {"surah_name": "الشرح", "surah_number": 94, "ayah_number": 8, "text": "وَإِلَىٰ رَبِّكَ فَارْغَب", "is_excerpt": false},
  "2:186": {"surah_name": "البقرة", "surah_number": 2, "ayah_number": 186, "text": "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ", "is_excerpt": true},
  "2:156": {"surah_name": "البقرة", "surah_number": 2, "ayah_number": 156, "text": "إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ", "is_excerpt": true},
  "20:46": {"surah_name": "طه", "surah_number": 20, "ayah_number": 46, "text": "لَا تَخَافَا إِنَّنِي مَعَكُمَا أَسْمَعُ وَأَرَىٰ", "is_excerpt": false},
  "3:173": {"surah_name": "آل عمران", "surah_number": 3, "ayah_number": 173, "text": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ", "is_excerpt": true},
  "3:134": {"surah_name": "آل عمران", "surah_number": 3, "ayah_number": 134, "text": "وَالْكَاظِمِينَ الْغَيْظَ وَالْعَافِينَ عَنِ النَّاسِ", "is_excerpt": true},
  "42:37": {"surah_name": "الشورى", "surah_number": 42, "ayah_number": 37, "text": "وَإِذَا مَا غَضِبُوا هُمْ يَغْفِرُونَ", "is_excerpt": true},
  "2:286": {"surah_name": "البقرة", "surah_number": 2, "ayah_number": 286, "text": "لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا", "is_excerpt": true},
  "4:40": {"surah_name": "النساء", "surah_number": 4, "ayah_number": 40, "text": "إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ ۖ وَإِن تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِن لَّدُنْهُ أَجْرًا عَظِيمًا", "is_excerpt": false},
  "4:148": {"surah_name": "النساء", "surah_number": 4, "ayah_number": 148, "text": "لَّا يُحِبُّ اللَّهُ الْجَهْرَ بِالسُّوءِ مِنَ الْقَوْلِ إِلَّا مَن ظُلِمَ ۚ وَكَانَ اللَّهُ سَمِيعًا عَلِيمًا", "is_excerpt": false}
}
